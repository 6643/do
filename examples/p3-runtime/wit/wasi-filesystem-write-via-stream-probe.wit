package wasi:filesystem@0.3.0-rc-2025-09-16;

interface types {
  enum error-code { io, no-entry }
  resource descriptor {
    write-via-stream: async func(
      data: stream<u8>,
      offset: u64,
    ) -> result<_, error-code>;
  }
}

interface probe {
  use types.{descriptor};
  run: async func(
    file: own<descriptor>,
    offset: u64,
  );
}

world write-via-stream-probe {
  import types;
  export probe;
}
