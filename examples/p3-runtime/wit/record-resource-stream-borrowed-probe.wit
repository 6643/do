package do:record-resource-stream-borrowed@0.1.0;

interface types {
  enum error-code { io }
}

interface source {
  use types.{error-code};
  resource ticket {}

  record resource-entry {
    ticket: borrow<ticket>,
  }
  read-via-stream: func() -> tuple<stream<resource-entry>, future<result<_, error-code>>>;
}

interface probe {
  use types.{error-code};
  run: async func() -> result<_, error-code>;
}

world record-resource-stream-borrowed {
  import types;
  import source;
  export probe;
}
