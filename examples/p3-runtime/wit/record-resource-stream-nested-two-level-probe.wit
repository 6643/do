package do:record-resource-stream-nested-two-level@0.1.0;

interface types {
  enum error-code { io, no-entry }
}

interface source {
  use types.{error-code};
  resource ticket {}

  record deep-entry {
    ticket: own<ticket>,
  }
  record inner-entry {
    deep: deep-entry,
  }
  record resource-entry {
    inner: inner-entry,
  }
  read-via-stream: func() -> tuple<stream<resource-entry>, future<result<_, error-code>>>;
}

interface probe {
  use types.{error-code};
  run: async func() -> result<_, error-code>;
}

world record-resource-stream-nested-two-level {
  import types;
  import source;
  export probe;
}
