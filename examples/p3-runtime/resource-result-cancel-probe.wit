package do:resource-probe@0.1.0;

interface http {
  resource request {}
  resource response {}

  enum error-code {
    failed,
  }

  send: async func(request: request) -> result<response, error-code>;
}

world async-resource-cancel-probe {
  use http.{request};
  import http;
  export cancel: async func(request: request);
}
