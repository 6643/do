package demo:marshal-record-nested-lower-deeper@1.0.0;

interface api {
  record leaf {
    code: u32,
    count: u64,
  }

  record header {
    leaf: leaf,
    status: s64,
  }

  record detail {
    header: header,
    marker: s64,
  }

  record writing {
    detail: detail,
    tail: s64,
  }

  write: func(value: writing);
}
