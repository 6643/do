package do:resource-probe@0.1.0;

interface http {
  resource request {}
  resource response {}

  enum error-code {
    failed,
  }

  send: async func(request: request) -> result<response, error-code>;
}

world async-resource-probe {
  use http.{request, response, error-code};

  import http;
  export run: async func(request: request) -> result<response, error-code>;
}
